# Copie para .env e preencha (o .env nunca vai para o git).
# No Lovable Cloud estes valores são criados automaticamente.

# Navegador (públicos)
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Opcionais (têm padrão)
# MODELO_CLAUDE=claude-opus-5-5
# PARECER_ESFORCO=medium
# PARECER_MOCK=true
# PARECER_CONCORRENCIA=4
# RAG_TOP_K=3

# Checklist Fácil (Parte 3b, ainda não usada pelo código)
CHECKLIST_FACIL_BASE_URL=https://app.checklistfacil.com.br/api/analytics
CHECKLIST_FACIL_INTEGRATION_URL=https://integration.checklistfacil.com.br
CHECKLIST_FACIL_API_TOKEN=

# Backup / restauração (rotas em src/routes/api/public/). Mínimo 16 caracteres;
# gere com: openssl rand -hex 32
CRON_SECRET=
# Deixe vazio para manter a restauração desligada.
RESTORE_TOKEN=
# BACKUP_RETENCAO=30
